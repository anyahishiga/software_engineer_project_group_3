# [API] Image cho server Python (Flask + gunicorn). Build từ thư mục gốc dự án (context: ..).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Ho_Chi_Minh

# tzdata: để TZ có tác dụng → "hôm nay" / giờ nhận hàng tính theo giờ Việt Nam, khớp với MySQL
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/

EXPOSE 5000

# 1) seed_users.py tạo admin / staff1 / staff2 nếu chưa có (chạy lại nhiều lần vẫn an toàn)
# 2) gunicorn chạy server Flask (backend/app.py, biến app)
CMD ["sh", "-c", "python -m backend.seed_users && exec gunicorn --bind 0.0.0.0:5000 --workers 2 --threads 4 backend.app:app"]
